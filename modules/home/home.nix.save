{ config, pkgs, inputs, lib, ... }:

{
  imports = [ inputs.hydenix.homeModules.default
];

  home.username = "kaiserone";
  home.homeDirectory = "/home/kaiserone";
  home.stateVersion = lib.mkForce "26.05";
  home.sessionVariables = {
    TZ = "Africa/Kinshasa";
  };
  hydenix.hm = {
    enable = true;
    theme = {
      enable = true;
      active = "Catppuccin Mocha";
    };
  };

  # On s'assure d'installer TOUTES les dépendances requises pour faire tourner HyDE sous Hyprland
  home.packages = [
    pkgs.google-chrome
    pkgs.mangohud
    pkgs.jetbrains-mono
    pkgs.acpi        
    pkgs.xarchiver        
    pkgs.unrar            
    pkgs.mpv              
    pkgs.libreoffice-fresh 
    pkgs.superfile        
    pkgs.aria2                   
    pkgs.faugus-launcher
    inputs.zen-browser.packages.${pkgs.system}.default
  ];

  xdg.desktopEntries.sklauncher = {
    name = "SKLauncher";
    exec = "java -jar /home/kaiserone/Applications/SKLauncher.jar";
    icon = "minecraft";
    comment = "Minecraft Launcher v4.0";
    categories = [ "Game" ];
    terminal = false;
  };

  xdg.userDirs = {
    enable = true;
    createDirectories = true;
  };

  xdg.mimeApps = {
    enable = true;
    defaultApplications = {
      "inode/directory" = [ "org.gnome.Nautilus.desktop" ];
      "video/mp4" = [ "mpv.desktop" ];
      "video/x-matroska" = [ "mpv.desktop" ];
      "video/webm" = [ "mpv.desktop" ];
      "video/quicktime" = [ "mpv.desktop" ];
      "audio/mpeg" = [ "mpv.desktop" ];
      "audio/ogg" = [ "mpv.desktop" ];
      "audio/wav" = [ "mpv.desktop" ];
      "audio/flac" = [ "mpv.desktop" ];
    };
  };

  programs.git = {
    enable = true;
    settings = {
      user = {
        name =  "kaiserone";
        email = "jjtchiteya07@gmail.com";
      };
    };
  };

  programs.home-manager.enable = true;
}

